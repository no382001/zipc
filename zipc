#!/bin/sh
# zipc [-adrh] [--color] FILE [IMAGE]; zipc -h lists the options. The command
# line is handled by prolog/cli.pl; this sets up what it needs: ZIP, the VM
# for -r (default build/zip), and ZIPC_TMP, a temporary image for -r.
root=$(dirname "$0")
export ZIP="${ZIP:-$root/build/zip}"
ZIPC_TMP=$(mktemp "${TMPDIR:-/tmp}/zipc.XXXXXX") || exit 1
export ZIPC_TMP
trap 'rm -f "$ZIPC_TMP"' EXIT
trap 'exit 130' INT TERM PIPE HUP
color=
[ -t 1 ] && [ -z "${NO_COLOR:-}" ] && color=--color
${SCRYER:-scryer-prolog} -f "$root/prolog/cli.pl" \
    -g zipc -g halt -- $color "$@" < /dev/null
