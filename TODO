% phase 2: atoms and structures

solve(true).
solve((A,B)) :- solve(A), solve(B).
solve(H) :- rule(H, B), solve(B).

rule(app([], L, L), true).
rule(app([H|T], L, [H|R]), app(T, L, R)).
rule(nrev([], []), true).
rule(nrev([H|T], R), (nrev(T, RT), app(RT, [H], R))).

?- solve(app(X, Y, [1,2,3])).   % 4 answers
?- solve(nrev([1,2,3], R)).     % R = [3,2,1]

% phase 3: cut

solve(true) :- !.
solve((A,B)) :- !, solve(A), solve(B).
solve(H) :- rule(H, B), solve(B).
